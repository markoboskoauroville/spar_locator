<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or carried to a new phone: the store list is spar.hr's and is fetched
     again, and the chosen city is one tap. The same as android:allowBackup="false" below 12. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
